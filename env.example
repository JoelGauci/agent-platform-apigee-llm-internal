# Common environment variables for Agent Gateway & Apigee X internal integration
export SLUG="apigee"
export REGION="us-central1"

# Google Cloud project variables
export PROJ_ID="your-project-id"
export PROJ_NO="your-project-number"
export ORG_ID="your-org-id"
export USER_IDENTITY="your-user-account@example.com"

# Agent Gateway and Runtime resources
export AGW_NAME="agw-${SLUG}-${REGION}-ata"
export AGW_URI="projects/${PROJ_ID}/locations/${REGION}/agentGateways/${AGW_NAME}"
export RE_AGENT_NAME="simple-agent"
export RE_AGENT_ID_SET="principalSet://agents.global.org-${ORG_ID}.system.id.goog/attribute.platformContainer/aiplatform/projects/${PROJ_NO}"
export STAGING_BUCKET="agent-staging-${PROJ_NO}"

# Apigee X Service Attachment URI (from Apigee X instance)
export APIGEE_SVC_ATTACHMENT="projects/your-apigee-tp/regions/${REGION}/serviceAttachments/apigee-${REGION}-xxxx"

# Apigee LLM AI Gateway configuration and credentials
export APIGEE_HOSTNAME="apigee.example.com"
export APIGEE_LLM="/v1/llm-ai-gateway"
export APIGEE_APIKEY="your-apigee-api-key"
export MODEL_NAME="apigee/vertex_ai/gemini-2.5-flash"
